# Local values come from `supabase status -o env` (API_URL and PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8000
KNOWLEDGE_SERVICE_TOKEN=
# Chat models: "ollama" runs them on this machine, "groq" uses Groq's free hosted API
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Needed only when MODEL_PROVIDER=groq (free key from console.groq.com)
GROQ_API_KEY=

# Secret used to hash IP addresses for rate limits (openssl rand -hex 32)
IP_HASH_SECRET=

# Cloudflare Turnstile site key. Local test key always passes: 1x00000000000000000000AA
# (the matching secret goes in supabase/.env, because Supabase Auth checks the token)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Set to true only behind a proxy that sets X-Real-IP or appends to X-Forwarded-For; otherwise per-IP limits are off and per-student limits still apply
TRUST_PROXY_IP_HEADERS=false
